// Arquivo de backup removido. Conteúdo limpo para manter diretório organizado.
// Se precisar do backup original, restaure a partir do histórico do editor.
    });

    // Monta lista de colunas dinâmicas
    const columns = Array.from(columnsSet).sort();

    // Renderiza cabeçalho
    const tbody = document.getElementById('dre-suecia-body');
    const thead = tbody.parentElement.querySelector('thead');
    if (thead) {
      thead.innerHTML = `<tr><th>Conta OCRA</th><th>Descrição</th>${columns.map(d => `<th>${d}</th>`).join('')}<th>Total</th></tr>`;
    }

    // Renderiza linhas principais
    const totaisPorCol = {};
    Object.keys(valores).sort().forEach(ocra => {
      const desc = ocraDesc[ocra] || '';
      const row = document.createElement('tr');
      let html = `<td>${ocra}</td><td>${desc}</td>`;
      let total = 0;
      columns.forEach(col => {
        const v = valores[ocra][col] || 0;
        html += `<td>${v.toLocaleString('pt-BR',{minimumFractionDigits:2, maximumFractionDigits:2})}</td>`;
        total += v;
        if (!totaisPorCol[col]) totaisPorCol[col] = 0;
        totaisPorCol[col] += v;
      });
      html += `<td>${total.toLocaleString('pt-BR',{minimumFractionDigits:2, maximumFractionDigits:2})}</td>`;
      row.innerHTML = html;
      tbody.appendChild(row);
    });

    // Linha de totais por coluna
    if (columns.length > 0) {
      const rowTotais = document.createElement('tr');
      let html = `<td colspan='2'><b>Total</b></td>`;
      let totalGeral = 0;
      columns.forEach(col => {
        const v = totaisPorCol[col] || 0;
        html += `<td><b>${v.toLocaleString('pt-BR',{minimumFractionDigits:2, maximumFractionDigits:2})}</b></td>`;
        totalGeral += v;
      });
      html += `<td><b>${totalGeral.toLocaleString('pt-BR',{minimumFractionDigits:2, maximumFractionDigits:2})}</b></td>`;
      rowTotais.innerHTML = html;
      tbody.appendChild(rowTotais);
    }

    // Exemplo de cálculo de percentual: Receita Líquida vs Total
    const receitaBruta = valores['1899'] || {};
    const deducoes = valores['3204'] || {};
    const receitaLiquida = {};
    columns.forEach(col => {
      receitaLiquida[col] = (receitaBruta[col] || 0) + (deducoes[col] || 0);
    });
    // Linha de Receita Líquida
    const rowRecLiq = document.createElement('tr');
    let htmlRecLiq = `<td colspan='2'><b>Receita Líquida</b></td>`;
    let totalRecLiq = 0;
    columns.forEach(col => {
      const v = receitaLiquida[col] || 0;
      htmlRecLiq += `<td><b>${v.toLocaleString('pt-BR',{minimumFractionDigits:2, maximumFractionDigits:2})}</b></td>`;
      totalRecLiq += v;
    });
    htmlRecLiq += `<td><b>${totalRecLiq.toLocaleString('pt-BR',{minimumFractionDigits:2, maximumFractionDigits:2})}</b></td>`;
    rowRecLiq.innerHTML = htmlRecLiq;
    tbody.appendChild(rowRecLiq);

    // Linha de percentual de cada coluna sobre o total
    const rowPerc = document.createElement('tr');
    let htmlPerc = `<td colspan='2'><b>% Receita Líquida</b></td>`;
    columns.forEach(col => {
      const v = receitaLiquida[col] || 0;
      const perc = totalRecLiq ? (v / totalRecLiq) * 100 : 0;
      htmlPerc += `<td><b>${perc.toFixed(2)}%</b></td>`;
    });
    htmlPerc += `<td></td>`;
    rowPerc.innerHTML = htmlPerc;
    tbody.appendChild(rowPerc);

    // Linha de Key Ratios: total de consultores por coluna
    if (keyRatiosData && Array.isArray(keyRatiosData)) {
      const consultoresPorCol = {};
      keyRatiosData.forEach(kr => {
        if (String(kr.ano) === String(year) && (type === 'monthly' ? Number(kr.mes) === month : Number(kr.mes) <= month)) {
          let groupKey = '';
          if (view === 'sbd') groupKey = String(kr.sbd || 'Não Classificado').trim();
          else if (view === 'departamento') groupKey = String(kr.departamento || 'Não Classificado').trim();
          else groupKey = String(kr.cliente || 'Não Classificado').trim();
          if (!consultoresPorCol[groupKey]) consultoresPorCol[groupKey] = 0;
          consultoresPorCol[groupKey] += 1;
        }
      });
      const rowKR = document.createElement('tr');
      let htmlKR = `<td colspan='2'><b>Consultores (Key Ratios)</b></td>`;
      columns.forEach(col => {
        const v = consultoresPorCol[col] || 0;
        htmlKR += `<td>${v}</td>`;
      });
      htmlKR += `<td></td>`;
      rowKR.innerHTML = htmlKR;
      tbody.appendChild(rowKR);
    }
  }
};
window.AbaDreSuecia = AbaDreSuecia;

```
