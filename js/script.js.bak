const app = {
            // Limpa todos os filtros da aba DRE
            clearDREFilters() {
                const ids = [
                    'dre-filter-cc',
                    'dre-filter-dept',
                    'dre-filter-client',
                    'dre-filter-sbd',
                    'dre-filter-proj'
                ];
                ids.forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.value = '';
                });
                this.renderDRE();
            },

            // Limpa todos os filtros da aba DRE Acumulado
            clearDREAcumuladoFilters() {
                const ids = [
