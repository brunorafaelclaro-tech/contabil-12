        const res = this.autoMapBudgetUsingHeuristics(false);
        const msg = `Auto-map (preview): ${res.tempMapped || 0}/${res.tempTotal || 0} sugestões.`;
        this.showToast(msg);
        console.group('AutoMap Preview Examples');
        console.log(res.examples || []);
        console.groupEnd();
        return res;
